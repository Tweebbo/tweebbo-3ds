# Headless Azahar (3DS emulator) for automated screenshots.
FROM docker.io/library/ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      xvfb xdotool imagemagick x11-utils libgl1 libegl1 libopengl0 libglu1-mesa libxi6 libxrender1 libxrandr2 libxcursor1 libxinerama1 libsm6 libice6 libgbm1 libwayland-client0 libwayland-egl1 libusb-1.0-0 libjack-jackd2-0 libsndio7.0 libharfbuzz0b libfreetype6 libglib2.0-0t64 libgl1-mesa-dri libglx-mesa0 \
      libfontconfig1 libxkbcommon-x11-0 libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
      libxcb-randr0 libxcb-render-util0 libxcb-shape0 libxcb-xinerama0 libxcb-xkb1 libdbus-1-3 \
      libpulse0 libasound2t64 libsdl2-2.0-0 libvulkan1 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
